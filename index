<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BIN Country Checker</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      color: #111827;
    }

    .container {
      width: 100%;
      max-width: 500px;
      background: white;
      padding: 30px;
      border-radius: 16px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }

    h1 {
      margin-top: 0;
      text-align: center;
      color: #1e3a8a;
    }

    .description {
      text-align: center;
      color: #4b5563;
      line-height: 1.5;
    }

    .warning {
      margin: 20px 0;
      padding: 12px;
      border-radius: 8px;
      background: #fef3c7;
      color: #92400e;
      font-size: 14px;
      line-height: 1.4;
    }

    label {
      display: block;
      margin: 20px 0 8px;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 18px;
      letter-spacing: 2px;
      outline: none;
    }

    input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    button {
      width: 100%;
      margin-top: 18px;
      padding: 13px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: white;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #1d4ed8;
    }

    button:disabled {
      background: #94a3b8;
      cursor: not-allowed;
    }

    .message {
      margin-top: 20px;
      padding: 15px;
      border-radius: 8px;
      display: none;
      line-height: 1.6;
    }

    .success {
      display: block;
      background: #dcfce7;
      color: #166534;
    }

    .error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
    }

    .loading {
      display: block;
      background: #e0f2fe;
      color: #075985;
    }

    .result-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      padding: 6px 0;
    }

    .result-row:last-child {
      border-bottom: none;
    }

    .footer {
      margin-top: 22px;
      text-align: center;
      font-size: 12px;
      color: #6b7280;
    }
  </style>
</head>
<body>
  <main class="container">
    <h1>BIN Country Checker</h1>

    <p class="description">
      Enter the first 6–8 digits of a card to check its issuing country.
    </p>

    <div class="warning">
      <strong>Important:</strong> Do not enter your full card number, CVV,
      PIN, expiration date, or any other sensitive card information.
    </div>

    <form id="binForm">
      <label for="binInput">Card BIN / IIN</label>

      <input
        id="binInput"
        type="text"
        inputmode="numeric"
        maxlength="8"
        placeholder="Example: 457173"
        autocomplete="off"
        required
      />

      <button id="checkButton" type="submit">
        Check Country
      </button>
    </form>

    <div id="message" class="message"></div>

    <div class="footer">
      Results are based on publicly available BIN information and may not
      always be accurate.
    </div>
  </main>

  <script>
    const form = document.getElementById("binForm");
    const binInput = document.getElementById("binInput");
    const message = document.getElementById("message");
    const checkButton = document.getElementById("checkButton");

    // Allow only numbers while typing
    binInput.addEventListener("input", () => {
      binInput.value = binInput.value.replace(/\D/g, "").slice(0, 8);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const bin = binInput.value.trim();

      if (!/^\d{6,8}$/.test(bin)) {
        showMessage(
          "Please enter between 6 and 8 digits.",
          "error"
        );
        return;
      }

      showMessage("Looking up BIN information...", "loading");
      checkButton.disabled = true;

      try {
        const response = await fetch(
          `https://lookup.binlist.net/${bin}`,
          {
            headers: {
              "Accept-Version": "3"
            }
          }
        );

        if (!response.ok) {
          throw new Error("BIN information was not found.");
        }

        const data = await response.json();

        const countryName = data.country?.name || "Not available";
        const countryCode = data.country?.alpha2 || "Not available";
        const bankName = data.bank?.name || "Not available";
        const cardType = data.type || "Not available";
        const cardBrand = data.brand || "Not available";
        const scheme = data.scheme || "Not available";

        message.className = "message success";
        message.innerHTML = `
          <div class="result-row">
            <strong>Country:</strong>
            <span>${escapeHTML(countryName)}</span>
          </div>

          <div class="result-row">
            <strong>Country Code:</strong>
            <span>${escapeHTML(countryCode)}</span>
          </div>

          <div class="result-row">
            <strong>Bank/Issuer:</strong>
            <span>${escapeHTML(bankName)}</span>
          </div>

          <div class="result-row">
            <strong>Network:</strong>
            <span>${escapeHTML(scheme)}</span>
          </div>

          <div class="result-row">
            <strong>Brand:</strong>
            <span>${escapeHTML(cardBrand)}</span>
          </div>

          <div class="result-row">
            <strong>Card Type:</strong>
            <span>${escapeHTML(cardType)}</span>
          </div>
        `;
      } catch (error) {
        showMessage(
          "Unable to find BIN information. Check the digits or try again later.",
          "error"
        );
      } finally {
        checkButton.disabled = false;
      }
    });

    function showMessage(text, type) {
      message.className = `message ${type}`;
      message.textContent = text;
    }

    // Prevent API data from being inserted as unsafe HTML
    function escapeHTML(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }
  </script>
</body>
</html>
